Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Captured path1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
    Expanded:
      - /Current View1
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
      Alpha: 0.5
      Plane: XY
      Offset:
        X: 0
        Y: 0
        Z: 0
      Reference Frame: <Fixed Frame>
      Normal Cell Count: 0
      Line Style:
        Line Width: 0.03
        Value: Lines
    - Class: rviz_default_plugins/Path
      Name: Captured path
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /path_capture/path
      Color: 25; 255; 0
      Alpha: 1
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Head Length: 0.3
      Head Diameter: 0.2
      Shaft Length: 1
      Shaft Diameter: 0.1
    - Class: rviz_default_plugins/MarkerArray
      Name: Waypoints
      Enabled: true
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /path_capture/markers
    - Class: rviz_default_plugins/Path
      Name: Drone trail
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /path_capture/trail
      Color: 255; 170; 0
      Alpha: 0.8
      Line Style: Lines
      Line Width: 0.02
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Head Length: 0.3
      Head Diameter: 0.2
      Shaft Length: 1
      Shaft Diameter: 0.1
    - Class: rviz_default_plugins/Pose
      Name: Drone
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /path_capture/drone
      Color: 255; 25; 0
      Alpha: 1
      Shape: Arrow
      Head Length: 0.5
      Head Radius: 0.25
      Shaft Length: 1
      Shaft Radius: 0.1
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 30
      Angle: 0
      Invert Z Axis: false
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      X: 8
      Y: -4
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
